{
  "name": "@moejay/m21",
  "version": "0.7.0",
  "description": "Spec-driven dependency graph visualizer with composable modules and feature tracking",
  "type": "module",
  "bin": {
    "m21": "bin/m21.js"
  },
  "main": "./src/parser.js",
  "exports": {
    ".": "./src/parser.js",
    "./server": "./src/server.js",
    "./generator": "./src/generator.js",
    "./results": "./src/results.js",
    "./cycles": "./src/cycles.js",
    "./package.json": "./package.json"
  },
  "files": [
    "bin/",
    "src/",
    "vendor/",
    "skills/",
    "README.md",
    "VISION.md"
  ],
  "keywords": [
    "spec",
    "dependency-graph",
    "visualization",
    "gherkin",
    "markdown",
    "frontmatter",
    "d3",
    "modular",
    "architecture"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moejay/m21.git"
  },
  "homepage": "https://moejay.github.io/m21",
  "scripts": {
    "test": "vitest run --reporter=default --reporter=json --outputFile=results/vitest-results.json",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "chokidar": "^5.0.0",
    "gray-matter": "^4.0.3",
    "open": "^10.1.0"
  },
  "devDependencies": {
    "@amiceli/vitest-cucumber": "^5.2.1",
    "@eslint/js": "^9.39.4",
    "d3": "^7.9.0",
    "eslint": "^9.39.4",
    "jsdom": "^29.1.1",
    "vitest": "^3.1.1"
  }
}
